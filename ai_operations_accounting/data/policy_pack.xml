<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Accounting Intelligence.

        POST-FREEZE OWNER DECISION, 2026-09-07. This file previously created the
        agent with no tools and no permissions at all, because Document B §1 put
        Finance outside Phase 1. George asked for a working Accountant agent
        after trying the staging demo, so it becomes operational — READ-ONLY.

        The earlier note in this file argued that granting account.move would
        subtract from what the platform is sold on, and cited Document B §11's
        isolation rows. That argument still stands, and nothing here weakens it,
        because every one of those rows is about a DIFFERENT agent:

          §11 row 1  PROCUREMENT asked for net profit          -> still refused
          §11 row 2  the same with the system prompt rewritten -> still refused
          §11 row 4  QUALITY asked the value of shipments      -> still refused
          §13 X-04   a posted account.move exists so that the four operational
                     agents can be refused it                  -> unchanged

        Not one of the four operational profiles gains a permission in this
        change. An accountant reading an ageing report and a Procurement agent
        reading net profit are different questions, and the tests for both now
        sit side by side in tests/test_accounting_roster.py.

        The boundary that did NOT move: this profile is read-only. Below there
        are three perm_read grants and nothing else — no perm_create, no
        perm_write, no perm_unlink, and not a single action permission in the
        file. max_autonomy_level stays 0 (QUERY), so guard step 15 refuses any
        action needing more even if a permission were added by mistake.

        Deliberately absent, each with a test asserting it stays absent:
        account.move.line, account.payment, account.journal, account.tax,
        account.full.reconcile and res.partner.bank. Posting, paying,
        reconciling, changing a tax and changing bank data are all out of reach
        because the models behind them are out of reach.
    -->
    <record id="profile_accounting" model="ai.operations.agent.profile">
        <field name="name">Accounting Intelligence</field>
        <field name="code">accounting</field>
        <field name="active" eval="False"/>
        <field name="max_autonomy_level">0</field>
        <field name="policy_version">1.1.0</field>
        <field name="description">Read-only financial reporting. You have four working tools and you should use them: receivable ageing, payable ageing, unpaid customer invoices, and invoiced revenue by period. Answer financial questions by calling them. You have no WRITE capability of any kind -- you cannot post a journal entry, validate a payment, change a reconciliation, change a tax or touch bank data -- but reading and reporting is exactly what you are for.</field>
    </record>

    <record id="perm_account_move_a" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_accounting"/>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="perm_read" eval="True"/>
    </record>

    <record id="perm_res_partner_a" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_accounting"/>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="perm_read" eval="True"/>
    </record>

    <record id="perm_res_currency_a" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_accounting"/>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="perm_read" eval="True"/>
    </record>

</odoo>
