<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Styled the way Odoo styles its own chat window: theme-aware Bootstrap
        utilities in the markup (bg-100, bg-inherit, border-secondary,
        text-muted), and almost nothing in SCSS. That is what makes it follow
        the light and dark themes instead of fighting them.
    -->
    <t t-name="ai_operations_chat_widget.ChatWidget">
        <div class="o_ai_chat_widget" t-if="state.available">

            <div t-if="state.open"
                 class="o_ai_chat_panel bg-100 border border-secondary rounded shadow d-flex flex-column overflow-hidden"
                 role="dialog" aria-label="AI Operations chat">

                <!-- header -->
                <div class="o_ai_chat_header bg-inherit border-bottom border-secondary d-flex align-items-center gap-2 px-2 py-1 flex-shrink-0">
                    <i class="fa fa-comments-o text-primary" role="img"/>
                    <div class="flex-grow-1 text-truncate lh-sm">
                        <div class="fw-bold small">AI Operations</div>
                        <div class="text-muted smaller text-truncate"
                             t-esc="activeProfile ? activeProfile.name : ''"/>
                    </div>
                    <button class="btn btn-sm btn-link p-1 text-muted" t-if="state.channelId"
                            t-on-click="openInDiscuss"
                            title="Open in Discuss" aria-label="Open in Discuss">
                        <i class="fa fa-external-link"/>
                    </button>
                    <button class="btn btn-sm btn-link p-1 text-muted" t-on-click="minimize"
                            title="Minimize" aria-label="Minimize">
                        <i class="fa fa-minus"/>
                    </button>
                    <button class="btn btn-sm btn-link p-1 text-muted" t-on-click="close"
                            title="Close" aria-label="Close">
                        <i class="fa fa-times"/>
                    </button>
                </div>

                <!-- agent selector -->
                <div class="px-2 py-1 border-bottom border-secondary flex-shrink-0"
                     t-if="state.profiles.length > 1">
                    <select class="form-select form-select-sm"
                            t-on-change="onSelectProfile" aria-label="Agent">
                        <t t-foreach="state.profiles" t-as="profile" t-key="profile.id">
                            <option t-att-value="profile.id"
                                    t-att-selected="profile.id === state.profileId"
                                    t-esc="profile.name"/>
                        </t>
                    </select>
                </div>

                <!-- conversation -->
                <div class="o_ai_chat_thread flex-grow-1 overflow-auto p-2 d-flex flex-column gap-2"
                     t-ref="thread">
                    <div t-if="state.loading" class="text-muted small text-center my-auto">
                        Loading the conversation…
                    </div>
                    <div t-elif="!state.messages.length"
                         class="text-muted small text-center my-auto px-2">
                        Ask about your own data. Every answer is checked against what you
                        are allowed to see.
                    </div>
                    <t t-foreach="state.messages" t-as="message" t-key="message.id or message_index">
                        <div t-attf-class="o_ai_chat_row d-flex {{ message.author === 'user' ? 'justify-content-end' : 'justify-content-start' }}">
                            <div t-attf-class="o_ai_chat_bubble rounded px-2 py-1 small {{ message.author === 'user' ? 'bg-primary text-white' : 'o_ai_chat_bubble_agent' }}">
                                <div class="o_ai_chat_body" t-esc="message.body"/>
                                <div t-if="message.date"
                                     t-attf-class="o_ai_chat_time smaller {{ message.author === 'user' ? 'text-white-50' : 'text-muted' }}"
                                     t-esc="formatTime(message.date)"/>
                            </div>
                        </div>
                    </t>
                    <div t-if="state.sending" class="d-flex justify-content-start">
                        <div class="o_ai_chat_bubble o_ai_chat_bubble_agent rounded px-2 py-1">
                            <span class="o_ai_chat_dot"/><span class="o_ai_chat_dot"/><span class="o_ai_chat_dot"/>
                        </div>
                    </div>
                </div>

                <!-- error -->
                <div t-if="state.error"
                     class="alert alert-warning d-flex align-items-center justify-content-between gap-2 m-2 py-1 px-2 small">
                    <span t-esc="state.error"/>
                    <button class="btn btn-sm btn-link p-0" t-on-click="retry">Retry</button>
                </div>

                <!-- composer -->
                <div class="o_ai_chat_composer border-top border-secondary p-2 flex-shrink-0">
                    <!-- the attached image, once one is chosen -->
                    <div t-if="state.pending"
                         class="o_ai_chat_pending d-flex align-items-center gap-2 mb-2 small">
                        <i class="fa fa-picture-o"/>
                        <span class="text-truncate" t-esc="state.pending.name"/>
                        <button class="btn btn-sm btn-link p-0 ms-auto"
                                t-on-click="clearPending"
                                title="Remove" aria-label="Remove attachment">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="d-flex align-items-end gap-2">
                        <label class="btn btn-light btn-sm d-flex align-items-center mb-0"
                               title="Attach an image" aria-label="Attach an image">
                            <i t-if="!state.uploading" class="fa fa-paperclip"/>
                            <i t-else="" class="fa fa-circle-o-notch fa-spin"/>
                            <input type="file" class="d-none"
                                   accept="image/png,image/jpeg,image/gif,image/webp"
                                   t-on-change="onFileSelected"/>
                        </label>
                        <textarea class="form-control form-control-sm"
                                  t-model="state.draft" t-on-keydown="onKeydown"
                                  rows="1" placeholder="Message the agent…"
                                  aria-label="Message"/>
                        <button class="btn btn-primary btn-sm d-flex align-items-center"
                                t-on-click="send"
                                t-att-disabled="state.sending or (!state.draft.trim() and !state.pending)"
                                title="Send" aria-label="Send">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>
            </div>

            <button class="o_ai_chat_launcher btn btn-link o-dropdown d-flex align-items-center"
                    t-on-click="toggle" title="AI Operations"
                    aria-label="AI Operations chat"
                    t-att-class="{ 'o-active': state.open }">
                <i class="fa fa-comments" role="img"/>
                <!--
                    Work handed over by another department. Counted, because
                    "you have something" and "you have four things" are
                    different mornings.
                -->
                <span t-if="state.waiting"
                      class="badge rounded-pill text-bg-danger o_ai_chat_badge"
                      t-esc="state.waiting"
                      t-att-aria-label="state.waiting + ' incoming requests'"/>
            </button>
        </div>
    </t>

</templates>
