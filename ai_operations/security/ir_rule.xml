<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Company scoping on the policy records themselves. This is ordinary Odoo
        authorisation, and it is deliberately the ONLY record rule the kernel
        ships: sub-company scoping (warehouse, branch, location) belongs beneath
        USER_PERMISSION in its own addon, never here. Document C 12.
    -->
    <record id="rule_agent_profile_company" model="ir.rule">
        <field name="name">AI agent profile: company scope</field>
        <field name="model_id" ref="model_ai_operations_agent_profile"/>
        <field name="domain_force">['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!--
        Agent eligibility is deliberately NOT a record rule.

        It was one, briefly, and the kernel's own mechanics broke on it. A
        record rule scoping ai.operations.agent.profile to ('user_ids','in',
        user.id) also hides every profile a user is not assigned, including the
        RECEIVER of a handoff they are entitled to raise. Khalid raising a
        material shortage to Procurement reads the target profile's code, and
        that read became an AccessError: a crash the user sees as a server
        error, not a refusal, in the middle of the flagship demo path. Routing
        users, audit rows and handoffs all legitimately reference profiles their
        reader does not own.

        So eligibility is enforced where a decision is actually being made:
        ai_widget_profiles' domain for the selector, action_open_chat for
        opening one, and check_eligibility inside the runtime for using one.
        Nothing narrows plain reads of the policy table. See
        security_service.check_eligibility.
    -->
    <record id="rule_model_permission_company" model="ir.rule">
        <field name="name">AI model permission: follows its profile</field>
        <field name="model_id" ref="model_ai_operations_model_permission"/>
        <field name="domain_force">['|', ('profile_id.company_ids', '=', False), ('profile_id.company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!--
        The audit log. A plain agent user may read only their own entries; the
        Auditor reads everything. Group rules are OR'ed, so the Auditor's rule
        widens rather than fights the User's. Nobody may write or unlink: the
        ACL grants create only, and the model refuses write() and unlink()
        outright.
    -->
    <record id="rule_audit_log_own_entries" model="ir.rule">
        <field name="name">AI audit log: own entries</field>
        <field name="model_id" ref="model_ai_operations_audit_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('ai_operations.group_ai_user'))]"/>
    </record>

    <record id="rule_audit_log_auditor_reads_all" model="ir.rule">
        <field name="name">AI audit log: the auditor reads everything</field>
        <field name="model_id" ref="model_ai_operations_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('ai_operations.group_ai_auditor'))]"/>
    </record>

    <record id="rule_action_permission_company" model="ir.rule">
        <field name="name">AI action permission: follows its profile</field>
        <field name="model_id" ref="model_ai_operations_action_permission"/>
        <field name="domain_force">['|', ('profile_id.company_ids', '=', False), ('profile_id.company_ids', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
