<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_model_permission_list" model="ir.ui.view">
        <field name="name">ai.operations.model.permission.list</field>
        <field name="model">ai.operations.model.permission</field>
        <field name="arch" type="xml">
            <list string="Model Permissions">
                <field name="profile_id"/>
                <field name="model_id"/>
                <field name="perm_read"/>
                <field name="perm_create"/>
                <field name="perm_write"/>
                <field name="perm_unlink"/>
                <field name="domain"/>
                <field name="state_restriction"/>
                <field name="max_records"/>
                <field name="data_classification"/>
            </list>
        </field>
    </record>

    <record id="view_ai_model_permission_form" model="ir.ui.view">
        <field name="name">ai.operations.model.permission.form</field>
        <field name="model">ai.operations.model.permission</field>
        <field name="arch" type="xml">
            <form string="Model Permission">
                <sheet>
                    <group>
                        <group string="Target">
                            <field name="profile_id"/>
                            <field name="model_id"/>
                            <field name="active"/>
                        </group>
                        <group string="Operations">
                            <field name="perm_read"/>
                            <field name="perm_create"/>
                            <field name="perm_write"/>
                            <field name="perm_unlink"/>
                        </group>
                        <group string="Record Scope">
                            <field name="domain" placeholder="[('company_id', 'in', [1])]"/>
                            <field name="state_restriction" placeholder="state=draft"/>
                            <field name="max_records"/>
                            <field name="allow_read_group"/>
                        </group>
                        <group string="Classification">
                            <field name="data_classification"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The domain is literal-only: it is parsed with
                        <code>ast.literal_eval</code>, never <code>eval</code>, so a name,
                        a lambda or a function call is rejected on save. The state
                        restriction must name its field
                        (<code>state=draft</code>, <code>stage_id.name=New</code>);
                        a bare value is invalid.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_model_permission" model="ir.actions.act_window">
        <field name="name">Model Permissions</field>
        <field name="res_model">ai.operations.model.permission</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
