<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="profile_quality" model="ai.operations.agent.profile">
        <field name="name">Quality Intelligence</field>
        <field name="code">quality</field>
        <field name="active" eval="False"/>
        <field name="max_autonomy_level">2</field>
        <field name="policy_version">1.0.0</field>
        <field name="description">Out-of-spec detection, lot trace in both
            directions, recall impact assessment. You can say who received
            affected product. You cannot say what it was worth, and that refusal
            is the point.</field>
    </record>

    <record id="perm_stock_lot" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="perm_stock_move_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="perm_stock_move_line_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="perm_stock_quant_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="perm_stock_location_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="perm_product_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="perm_read" eval="True"/>
    </record>
    <record id="perm_mrp_production_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Document B 4.4 constrains this to the trace endpoints, and the record
         had no domain: every partner in company scope was readable, held back
         only by what the output schemas happened to emit. Field exposure was
         bounded; RECORD exposure was not. A recall follows product to whoever
         received it, so the endpoints are customers and suppliers. -->
    <record id="perm_res_partner_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="perm_read" eval="True"/>
        <field name="domain">['|', ('customer_rank', '>', 0), ('supplier_rank', '>', 0)]</field>
    </record>

    <!-- The autonomous trigger. See ai_operations_procurement for why it ships
         inactive and carries no identity of its own. -->
    <record id="cron_ai_quality" model="ir.cron">
        <field name="name">AI Operations: Quality daily review</field>
        <field name="model_id" ref="ai_operations.model_ai_operations_execution"/>
        <field name="state">code</field>
        <field name="code">model.run('quality', 'CRON', entry_prompt='Daily quality review. Check overnight check results, anything out of spec, and lots still pending release past the 48 hour hold. For a confirmed exceedance: trace it forward, propose a hold, and hand the impact to Inventory and the affected orders to Manufacturing.')</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=45, second=0, microsecond=0) + relativedelta(days=1))"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="False"/>
    </record>



    <!-- Document B 4.4: result and status only. The agent whose purpose is out-of-spec detection could not read a quality check at all. -->
    <record id="perm_quality_check_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="quality.model_quality_check"/>
        <field name="perm_read" eval="True"/>
    </record>

    <record id="perm_quality_point_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="quality.model_quality_point"/>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Decision 1: propose_hold writes a native DRAFT quality.alert. Draft only, enforced by the state restriction; it moves no stock. -->
    <record id="perm_quality_alert_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="quality.model_quality_alert"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <!-- Document C §5.2 is explicit: quality.alert has NO state field, it
             uses stage_id pointing at quality.alert.stage. The shipped value
             was `state=draft`, which named a field that does not exist on the
             one model this agent may write. -->
        <field name="state_restriction">stage_id.name=New</field>
    </record>

    <record id="perm_stock_picking_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="perm_read" eval="True"/>
    </record>

    <record id="perm_product_tmpl_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="perm_read" eval="True"/>
    </record>

    <!-- 4.4: raises QUALITY_HOLD_IMPACT and QUALITY_HOLD_PRODUCTION. -->
    <record id="perm_handoff_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="ai_operations.model_ai_operations_handoff"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
    </record>

    <!-- Document B 4.5. Write is scoped to the activities this identity created: an agent updates its own activity to deduplicate and can never touch a human's or another agent's. $EXECUTION_USER is resolved by the guard; the domain itself stays a literal. -->
    <record id="perm_mail_activity_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="domain">[('create_uid', '=', '$EXECUTION_USER')]</field>
    </record>

    <!-- Create only, never read. An agent may add to a conversation and may never rewrite one, and chatter is exactly where a prompt-injection payload would be planted. -->
    <record id="perm_mail_message_q" model="ai.operations.model.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="perm_create" eval="True"/>
    </record>

    <!-- 9 step 8: the agent proposes, the human executes. -->
    <record id="action_create_alert_q" model="ai.operations.action.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="quality.model_quality_alert"/>
        <field name="action_code">CREATE_DRAFT</field>
        <field name="allowed" eval="True"/>
        <field name="autonomy_required">2</field>
        <field name="risk_level">MEDIUM</field>
        <field name="state_restriction">stage_id.name=New</field>
    </record>

    <record id="action_create_activity_q" model="ai.operations.action.permission">
        <field name="profile_id" ref="profile_quality"/>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="action_code">CREATE</field>
        <field name="allowed" eval="True"/>
        <field name="autonomy_required">2</field>
        <field name="risk_level">LOW</field>
    </record>


    <!-- Document B 6.2 and 9 steps 9 and 10. A confirmed exceedance fans out
         two ways: Inventory is told where the affected stock sits, Manufacturing
         which orders are consuming it. Neither payload carries a value, and
         neither grants the receiver anything it did not already hold. -->
    <record id="handoff_type_hold_impact" model="ai.operations.handoff.type">
        <field name="code">QUALITY_HOLD_IMPACT</field>
        <field name="name">Quality Hold Impact</field>
        <field name="from_profile_ids" eval="[Command.link(ref('profile_quality'))]"/>
        <field name="to_profile_id" ref="ai_operations_inventory.profile_inventory"/>
        <field name="priority_default">3</field>
        <field name="payload_schema">{"lot_ids": "list", "product_id": "int", "reason_code": "str", "severity": "str", "locations_affected": "list", "origin_ref": "str"}</field>
    </record>

    <record id="handoff_type_hold_production" model="ai.operations.handoff.type">
        <field name="code">QUALITY_HOLD_PRODUCTION</field>
        <field name="name">Quality Hold Production</field>
        <field name="from_profile_ids" eval="[Command.link(ref('profile_quality'))]"/>
        <field name="to_profile_id" ref="ai_operations_manufacturing.profile_manufacturing"/>
        <field name="priority_default">3</field>
        <field name="payload_schema">{"lot_ids": "list", "product_id": "int", "mo_ids_affected": "list", "reason_code": "str", "severity": "str", "origin_ref": "str"}</field>
    </record>

</odoo>
