<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_stock_warehouse_scope" model="res.groups.privilege">
        <field name="name">Warehouse Scope</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_stock_warehouse_scoped" model="res.groups">
        <field name="name">Restricted to Allowed Warehouses</field>
        <field name="privilege_id" ref="privilege_stock_warehouse_scope"/>
        <field name="comment">A user in this group sees stock only in the
            warehouses listed on their user record. Users outside the group are
            unaffected: the rules below are group rules, not global ones.</field>
    </record>

</odoo>
