<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_handoff_list" model="ir.ui.view">
        <field name="name">ai.operations.handoff.list</field>
        <field name="model">ai.operations.handoff</field>
        <field name="arch" type="xml">
            <list string="Handoffs" create="false">
                <field name="name"/>
                <field name="type_id"/>
                <field name="from_profile_id"/>
                <field name="to_profile_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="required_date"/>
                <field name="idempotency_key" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_handoff_form" model="ir.ui.view">
        <field name="name">ai.operations.handoff.form</field>
        <field name="model">ai.operations.handoff</field>
        <field name="arch" type="xml">
            <form string="Handoff" create="false" edit="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Routing">
                            <field name="type_id"/>
                            <field name="from_profile_id"/>
                            <field name="to_profile_id"/>
                            <field name="state"/>
                        </group>
                        <group string="Reference">
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="correlation_id"/>
                            <field name="idempotency_key"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The receiving agent resolves records through its own model
                        permissions. These references are labels for human
                        traceability; they grant nothing.
                    </div>
                    <group string="Payload"><field name="payload"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_handoff" model="ir.actions.act_window">
        <field name="name">Handoffs</field>
        <field name="res_model">ai.operations.handoff</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ai_handoff_type_list" model="ir.ui.view">
        <field name="name">ai.operations.handoff.type.list</field>
        <field name="model">ai.operations.handoff.type</field>
        <field name="arch" type="xml">
            <list string="Handoff Types">
                <field name="code"/>
                <field name="name"/>
                <field name="to_profile_id"/>
                <field name="priority_default"/>
            </list>
        </field>
    </record>

    <record id="action_ai_handoff_type" model="ir.actions.act_window">
        <field name="name">Handoff Types</field>
        <field name="res_model">ai.operations.handoff.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_handoff" name="Handoffs" parent="menu_ai_operations_root"
              action="action_ai_handoff" sequence="20"/>
    <menuitem id="menu_ai_handoff_type" name="Handoff Types"
              parent="menu_ai_operations_configuration"
              action="action_ai_handoff_type" sequence="60"/>
</odoo>
