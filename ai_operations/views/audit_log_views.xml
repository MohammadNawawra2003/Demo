<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_audit_log_list" model="ir.ui.view">
        <field name="name">ai.operations.audit.log.list</field>
        <field name="model">ai.operations.audit.log</field>
        <field name="arch" type="xml">
            <list string="Audit Log" create="false" edit="false" delete="false"
                  decoration-danger="decision == 'DENIED'"
                  decoration-warning="approval_required">
                <field name="create_date"/>
                <field name="event_type"/>
                <field name="profile_code"/>
                <field name="tool_code"/>
                <field name="decision"/>
                <field name="denial_reason"/>
                <field name="user_id"/>
                <field name="service_user_id" column_invisible="1"/>
                <field name="execution_mode"/>
                <field name="trigger"/>
                <field name="variance_pct" optional="hide"/>
                <field name="approval_required" optional="hide"/>
                <field name="idempotent_hit" optional="hide"/>
                <field name="retention_class" optional="hide"/>
                <field name="correlation_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_audit_log_form" model="ir.ui.view">
        <field name="name">ai.operations.audit.log.form</field>
        <field name="model">ai.operations.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Entry" create="false" edit="false" delete="false">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        This log is append-only. Rows are never edited or deleted,
                        including by the identity they record.
                    </div>
                    <group>
                        <group string="Call">
                            <field name="event_type"/>
                            <field name="correlation_id"/>
                            <field name="session_id"/>
                            <field name="tool_code"/>
                            <field name="action_code"/>
                        </group>
                        <group string="Identity">
                            <field name="profile_code"/>
                            <field name="user_id"/>
                            <field name="service_user_id"/>
                            <field name="execution_mode"/>
                            <field name="trigger"/>
                            <field name="company_id"/>
                        </group>
                        <group string="Decision">
                            <field name="decision"/>
                            <field name="denial_reason"/>
                            <field name="approval_required"/>
                            <field name="variance_pct"/>
                            <field name="idempotent_hit"/>
                            <field name="retention_class"/>
                        </group>
                        <group string="Provenance">
                            <field name="policy_version"/>
                            <field name="provider_code"/>
                            <field name="model_code"/>
                            <field name="duration_ms"/>
                            <field name="token_input"/>
                            <field name="token_output"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail" name="detail">
                            <field name="denial_detail"/>
                            <field name="models_accessed"/>
                            <field name="records_accessed"/>
                            <field name="output_summary"/>
                            <field name="error"/>
                        </page>
                        <page string="Values" name="values">
                            <field name="input_args"/>
                            <field name="values_before"/>
                            <field name="values_after"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_audit_log_search" model="ir.ui.view">
        <field name="name">ai.operations.audit.log.search</field>
        <field name="model">ai.operations.audit.log</field>
        <field name="arch" type="xml">
            <search string="Audit Log">
                <field name="correlation_id"/>
                <field name="tool_code"/>
                <field name="profile_code"/>
                <field name="user_id"/>
                <filter name="filter_denied" string="Denied"
                        domain="[('decision', '=', 'DENIED')]"/>
                <filter name="filter_escalated" string="Escalated"
                        domain="[('approval_required', '=', True)]"/>
                <separator/>
                <filter name="filter_security" string="Security Retention"
                        domain="[('retention_class', '=', 'SECURITY')]"/>
                <group>
                    <filter name="group_reason" string="Denial Reason" domain="[]"
                            context="{'group_by': 'denial_reason'}"/>
                    <filter name="group_profile" string="Agent" domain="[]"
                            context="{'group_by': 'profile_code'}"/>
                    <filter name="group_tool" string="Tool" domain="[]"
                            context="{'group_by': 'tool_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">ai.operations.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_denied': 0}</field>
    </record>

    <menuitem id="menu_ai_audit_log"
              name="Audit Log"
              parent="menu_ai_operations_root"
              action="action_ai_audit_log"
              sequence="10"/>

</odoo>
