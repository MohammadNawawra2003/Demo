<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_warehouse_scope" model="ir.ui.view">
        <field name="name">res.users.form.warehouse.scope</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="allowed_warehouse_ids" widget="many2many_tags"
                       groups="stock_security_warehouse.group_stock_warehouse_scoped"/>
            </xpath>
        </field>
    </record>

</odoo>
